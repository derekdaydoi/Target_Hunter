{
  "name": "derekos",
  "productName": "Target Hunter",
  "version": "1.8.1",
  "description": "Target Hunter - local-first goal, task and weekly review app",
  "author": "derekdaydoi",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "icon": "node scripts/icon.mjs",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "start": "vite build && electron .",
    "dist": "vite build && electron-builder --win nsis"
  },
  "build": {
    "appId": "com.derekos.app",
    "productName": "Target Hunter",
    "files": [
      "dist/**",
      "electron/**"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "electron/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "TargetHunter-Setup.exe",
      "shortcutName": "Target Hunter",
      "createDesktopShortcut": "always",
      "uninstallDisplayName": "Target Hunter"
    }
  },
  "dependencies": {
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
